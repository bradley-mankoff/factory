#!/usr/bin/env python3
"""Serves the Factory's demo folder read only on the loopback address (fac-3mz.10).

    demos-serve <folder> <port>

The Mac App Store and standalone editions of Tailscale cannot serve files from disk
("Path serving is not supported on macOS due to sandbox restrictions",
tailscale.com/kb/1065/macos-variants), so install starts this at login as the launchd job
factory.demos and has `tailscale serve` forward the /demos path of the Mac's Tailscale
address to http://127.0.0.1:<port>. The server binds 127.0.0.1 alone, so the videos are
reached through this Mac's tailnet and never from the network around it, and it answers
Range requests with 206, because Safari on iPhone plays an mp4 only from a server that
does.
"""
import mimetypes
import os
import re
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import unquote, urlsplit

# A Range request's bytes, in the three forms a player uses: a span (bytes=2-5), everything
# from one byte (bytes=0-) and a number of bytes at the end (bytes=-4). Anything else, such
# as several spans in one request, is answered as the whole file, which HTTP allows.
RANGE = re.compile(r"^bytes=(\d*)-(\d*)$")


class Demos(BaseHTTPRequestHandler):
    """Answers GET for the files in one folder, and refuses everything else."""

    protocol_version = "HTTP/1.1"
    folder = ""

    def do_GET(self):
        self.answer(send_body=True)

    def do_HEAD(self):
        self.answer(send_body=False)

    def do_PUT(self):
        self.read_only()

    do_POST = do_DELETE = do_PATCH = do_PUT

    def read_only(self):
        """Refuses every request that would change the folder: a Run writes its video, a
        request only reads it."""
        self.refuse(405, b"the demo folder is read only\n", headers=(("Allow", "GET, HEAD"),))

    def refuse(self, status, body, send_body=True, headers=()):
        """Answers a request that reaches no video: a status, a plain text body saying why
        and any header that goes with the status. A HEAD request gets the same answer
        without the body, as HTTP asks."""
        self.send_response(status)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        for name, value in headers:
            self.send_header(name, value)
        self.end_headers()
        if send_body:
            self.wfile.write(body)

    def file_path(self):
        """The path of the file this request names inside the folder, or None.

        The folder holds a Run's video by its name and nothing else, so a request for the
        folder itself is not found, and neither is one that climbs out of it with .., an
        absolute path or a link: the folder is the whole of what this server publishes.
        """
        name = unquote(urlsplit(self.path).path).lstrip("/")
        if not name or name.endswith("/"):
            return None
        folder = os.path.realpath(self.folder)
        path = os.path.realpath(os.path.join(folder, name))
        if os.path.commonpath([folder, path]) != folder or not os.path.isfile(path):
            return None
        return path

    def answer(self, send_body):
        """Writes the answer to one GET or HEAD: the bytes a Range request names, or the
        whole file when it names none or names several spans."""
        path = self.file_path()
        if path is None:
            return self.refuse(404, b"not found\n", send_body=send_body)
        size = os.path.getsize(path)
        start, end, status = 0, size - 1, 200
        match = RANGE.match(self.headers.get("Range", "").strip())
        if match and size > 0:
            begin, last = match.groups()
            start = int(begin) if begin else max(size - int(last or 0), 0)
            end = min(int(last), size - 1) if begin and last else size - 1
            if start >= size or start > end:
                # A range past the end names no bytes, so HTTP answers 416 with the size.
                return self.refuse(416, b"", send_body=False, headers=(("Content-Range", f"bytes */{size}"),))
            status = 206
        length = end - start + 1
        self.send_response(status)
        self.send_header("Content-Type", mimetypes.guess_type(path)[0] or "application/octet-stream")
        self.send_header("Accept-Ranges", "bytes")
        self.send_header("Content-Length", str(length))
        if status == 206:
            self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
        self.end_headers()
        if send_body:
            with open(path, "rb") as video:
                video.seek(start)
                remaining = length
                while remaining:
                    chunk = video.read(min(remaining, 64 * 1024))
                    if not chunk:
                        break
                    self.wfile.write(chunk)
                    remaining -= len(chunk)


def main():
    if len(sys.argv) != 3:
        sys.exit("usage: demos-serve <folder> <port>")
    folder, port = sys.argv[1], int(sys.argv[2])
    if not os.path.isdir(folder):
        sys.exit(f"demos-serve: no folder at {folder}")
    Demos.folder = folder
    ThreadingHTTPServer(("127.0.0.1", port), Demos).serve_forever()


if __name__ == "__main__":
    main()
