#!/usr/bin/env python3
"""Prints the Factory's node prompts as one JSON object, for a Workflow's first node.

Each Markdown file in ~/.local/share/factory/prompts/ is the convention for one kind
of AI node: `work`, `review_spec`, `review_standards`. A Workflow runs this as a bash
node with the id `prompts`, and each AI node's prompt starts with its convention,
`$prompts.output.work` for example, followed by what is particular to that Workflow.
Archon's own command files could hold them too, but a command file cannot see
`$LOOP_PREV`, which carries a review's findings back to the next pass of work.

    node-prompts [<workflow folder>]

With a Workflow folder, it also prints one `marker_<node>` for each node in the
Workflow's `flows/` folder. A marker is the one line the pi-flows package reads from a
node's prompt to find the node's checks and the project's check command:

    FLOWS {"node":"work","flows":"...","artifacts":"...","check":"..."}

The node is named by the flows file, the folders come from the environment the Run gives
this node, and the check command from the project's FACTORY_CHECK. That last field is
optional in the package, so a Mac with no check command leaves it out. A node without a
flows file has no checks, so it gets no marker and the package leaves its sessions alone.

The four names a checked node needs are kept in step by this script rather than by hand:
it reads the node ids from the Workflow YAML beside `flows/`, and fails this node, naming
the file, when a flows file names no node or a prompt in the YAML asks for a marker no
flows file produces. A Run then stops at its first node instead of running an agent with
no checks (fac-wtw). The marker key turns the file's dashes into underscores, so a dash
and an underscore are the same letter when the names are compared.

The prompts are the Factory's own, adapted from Matt Pocock's tdd and code-review
skills (MIT; prompts/LICENSE.txt) and no longer kept in step with his releases (the
Human, 2026-10-19).
"""
import json
import os
import pathlib
import re
import sys

bin_dir = pathlib.Path(__file__).resolve().parent
prompts = {path.stem: path.read_text() for path in sorted((bin_dir.parent / "prompts").glob("*.md"))}


def same_name(name):
    """A node id and a flows file name agree when only their dashes differ from underscores."""
    return name.replace("_", "-")


def flows_files(workflow, flows):
    """The checked nodes' flows files, once each has a node and the prompts name them."""
    yamls = sorted(workflow.glob("*.yaml"))
    if len(yamls) != 1:
        sys.exit(f"node-prompts: {workflow} needs one Workflow YAML beside its flows folder")
    yaml = yamls[0]
    text = yaml.read_text()
    node_ids = {same_name(node) for node in re.findall(r"^\s*-\s*id:\s*(\S+)", text, re.MULTILINE)}
    files = [path for path in sorted(flows.iterdir()) if path.is_file() and not path.name.startswith(".")]
    problems = [f"{path} names no node of {yaml}" for path in files if same_name(path.name) not in node_ids]
    produced = {same_name(path.name) for path in files}
    for wanted in sorted(set(re.findall(r"\$prompts\.output\.marker_(\w+)", text))):
        if same_name(wanted) not in produced:
            problems.append(f"{yaml} asks for $prompts.output.marker_{wanted}, which no flows file produces")
    if problems:
        sys.exit("node-prompts: " + "\nnode-prompts: ".join(problems))
    return files


if len(sys.argv) > 1:
    workflow = pathlib.Path(sys.argv[1]).resolve()
    flows = workflow / "flows"
    artifacts = os.environ.get("ARTIFACTS_DIR", "")
    check = os.environ.get("FACTORY_CHECK", "")
    if flows.is_dir():
        for path in flows_files(workflow, flows):
            key = "marker_" + path.name.replace("-", "_")
            marker = {
                "node": path.name,
                "flows": str(flows),
                "artifacts": artifacts,
            }
            if check:
                marker["check"] = check
            prompts[key] = "FLOWS " + json.dumps(marker)

print(json.dumps(prompts))
