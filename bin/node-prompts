#!/usr/bin/env python3
"""Prints the Factory's node prompts as one JSON object, for a Workflow's first node.

Each Markdown file in ~/.local/share/factory/prompts/ is the convention for one kind
of AI node: `work`, `review_spec`, `review_standards`. A Workflow runs this as a bash
node with the id `prompts`, and each AI node's prompt starts with its convention,
`$prompts.output.work` for example, followed by what is particular to that Workflow.
Archon's own command files could hold them too, but a command file cannot see
`$LOOP_PREV`, which carries a review's findings back to the next pass of work.

    node-prompts [<workflow folder>]

With a Workflow folder, it also prints one `marker_<node>` for each flows file in the
Workflow's `flows/` folder, the key spelled with the file's dashes as underscores. A
marker is the one line the pi-flows package reads from a node's prompt to find the node's
checks and the project's check command:

    FLOWS {"node":"work","bead":"fac-qpv.3.1","flows":"...","artifacts":"...","check":"..."}

The node is named by the flows file, the Bead by the end of $ARGUMENTS, the folders
from the environment the Run gives this node, and the check command from the project's
FACTORY_CHECK. That last field is optional in the package, so a Mac with no check
command leaves it out. The Bead is not optional: the installed pi-flows parser rejects a
marker without it, so it stays until pi-flows Bead pi-flows-y9u makes it optional
(fac-wtw). A node without a flows file has no checks, so it gets no marker and the
package leaves its sessions alone.

The id of a checked node, its flows file and its prompt key are compared here rather than
kept in step by hand: it reads the node ids from the Workflow YAML beside `flows/`, and
fails this node, naming the file, when a flows file names no node or a prompt in the YAML
asks for a marker no flows file produces. A Run then stops at its first node instead of
running an agent with no checks (fac-wtw). A flows file and the node it names compare
equal across dashes and underscores, `look_a` and `look-a`; the marker key spells a file's
dashes as underscores, so `flows/look-a` is `$prompts.output.marker_look_a`.

The prompts are the Factory's own, adapted from Matt Pocock's tdd and code-review
skills (MIT; prompts/LICENSE.txt) and no longer kept in step with his releases (the
Human, 2026-10-19).
"""
import json
import os
import pathlib
import re
import subprocess
import sys

bin_dir = pathlib.Path(__file__).resolve().parent
prompts = {path.stem: path.read_text() for path in sorted((bin_dir.parent / "prompts").glob("*.md"))}


def with_dashes(name):
    """One spelling of a name, so a dash and an underscore compare equal."""
    return name.replace("_", "-")


def marker_key(name):
    """The prompt key of a flows file: its name with the dashes written as underscores."""
    return "marker_" + name.replace("-", "_")


def checked_flows_files(workflow, flows):
    """The checked nodes' flows files, once each names a node and the prompts name them."""
    yamls = sorted(workflow.glob("*.yaml"))
    if len(yamls) != 1:
        sys.exit(f"node-prompts: {workflow} needs one Workflow YAML beside its flows folder")
    yaml = yamls[0]
    text = yaml.read_text()
    node_ids = {with_dashes(node) for node in re.findall(r"^\s*-\s*id:\s*(\S+)", text, re.MULTILINE)}
    files = [path for path in sorted(flows.iterdir()) if path.is_file() and not path.name.startswith(".")]
    problems = [f"{path} names no node of {yaml}" for path in files if with_dashes(path.name) not in node_ids]
    keys = {marker_key(path.name) for path in files}
    for wanted in sorted(set(re.findall(r"\$prompts\.output\.(marker_[\w-]+)", text))):
        if wanted not in keys:
            problems.append(f"{yaml} asks for $prompts.output.{wanted}, which no flows file produces")
    if problems:
        sys.exit("node-prompts: " + "\nnode-prompts: ".join(problems))
    return files


if len(sys.argv) > 1:
    workflow = pathlib.Path(sys.argv[1]).resolve()
    arguments = os.environ.get("ARGUMENTS", "")
    try:
        bead = subprocess.run(
            [str(bin_dir / "bead"), "--id", arguments],
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        bead = ""
    flows = workflow / "flows"
    artifacts = os.environ.get("ARTIFACTS_DIR", "")
    check = os.environ.get("FACTORY_CHECK", "")
    if flows.is_dir():
        for path in checked_flows_files(workflow, flows):
            key = marker_key(path.name)
            marker = {
                "node": path.name,
                "bead": bead,
                "flows": str(flows),
                "artifacts": artifacts,
            }
            if check:
                marker["check"] = check
            prompts[key] = "FLOWS " + json.dumps(marker)

print(json.dumps(prompts))
