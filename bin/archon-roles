#!/bin/sh
# Sets the roles Archon names — its small, medium and large tiers and the @aliases its
# Workflows use — to the Mac's Chain models, so no Workflow names a model or a seat
# (fac-qpv.1.4).
#
#   ARCHON_HOME=<Archon's home> bin/archon-roles
#
# scripts/install.sh runs this after it installs Archon. Archon writes its own config.yaml
# through these commands, so running this twice changes nothing. The Chains themselves are
# in the Chains file the Mac's Profile names, ~/.config/factory/chains.json by default,
# which the pi-chains package reads when pi starts.
set -eu
archon=${ARCHON_HOME:?ARCHON_HOME must name the Archon home}/bin/archon
# Work: the work agent, the standards review, research and demo agents, and Archon's
# default. On the personal Mac that Chain is DeepSeek v4.1 Flash at maximum (fac-qpv.1).
for tier in small medium large; do
	"$archon" ai tier set "$tier" pi chain/work --scope install >/dev/null
done
"$archon" ai default pi chain/work --scope install >/dev/null
for alias in @work @standards-review @reviewer; do
	"$archon" ai alias set "$alias" pi chain/work --scope install >/dev/null
done
# The spec review matters more than the work it reads, so it keeps a Chain of its own.
"$archon" ai alias set @spec-review pi chain/spec-review --scope install >/dev/null
