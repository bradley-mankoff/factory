#!/bin/sh
# The Beads board, beads-ui, for this Mac: started at login by the launchd job factory.bdui,
# written by scripts/install.sh, and run by install so the board is up today (fac-qpv.7.3).
#
# A Bead id in a Project Manager's reply is a link to that Bead on the board, so the board
# has to be running after a reboot, and it has to know the link's project. It listens on the
# port the Mac's Profile names, BOARD_PORT in ~/.config/factory/profile (3917 without one),
# the port the Bead links name too, and it is registered with every project listed in
# ~/.config/factory/projects, which is how beads-ui learns a project.
#
# The server starts in the first project in that list with a Beads database, since a fresh
# browser tab shows the board's current project and the home folder holds none.
#
# beads-ui keeps the projects it knows in the running server, not on disk, so they are
# registered again at each login; a project registered twice is still known once.
#
#   board
set -eu

bdui=${BDUI:-$(command -v bdui)} || {
	echo "board: bdui (beads-ui) is not on PATH, so there is no board to start" >&2
	exit 1
}

# The Profile names the port, and one written before the key existed names none, so the
# default stands until it does. The pi-links package links each Bead id to this same port and
# keeps the same 3917, since the link and the board have to agree.
BOARD_PORT=
profile=$HOME/.config/factory/profile
if [ -f "$profile" ]; then
	# shellcheck source=/dev/null
	. "$profile"
fi
port=${BOARD_PORT:-3917}

# beads-ui starts its server in the folder of the first start that finds it down and only
# registers later starts with the running one, so the boot below runs in the first project
# that holds a Beads database, before the loop that registers every project; the home
# folder is only the fallback when no project holds one.
projects=$HOME/.config/factory/projects
boot=
if [ -f "$projects" ]; then
	while IFS= read -r repo; do
		if [ -d "$repo/.beads" ]; then
			boot=$repo
			break
		fi
	done < "$projects"
fi
boot=${boot:-$HOME}
(cd "$boot" && "$bdui" start --port "$port") || echo "board: could not start the board in $boot" >&2
if [ -f "$projects" ]; then
	while IFS= read -r repo; do
		[ -d "$repo" ] || continue
		# A start in a project starts the server if it is down and registers the project
		# with the running one, so one loop covers the first login and every later one.
		(cd "$repo" && "$bdui" start --port "$port") || echo "board: could not register $repo" >&2
	done < "$projects"
fi
# The board is up even before the first project is in the list, so its first link opens.
cd "$boot"
exec "$bdui" start --port "$port"
