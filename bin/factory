#!/usr/bin/env python3
"""The factory command: the one place the Mac's Asks live and are read (fac-3mz.1 to
fac-3mz.3).

An Ask is one thing waiting on the Human (GLOSSARY.md): a Decision, a grilling round, a
Spec to review or a Human gate. Every kind but a gate is held in state the Factory already
has: a comment on the Bead or Epic it concerns, carrying the kind, the question in plain
words and how to answer, plus the `waiting-on-human` label on that Bead. The label is what
`factory asks` finds those Asks by; the comment is where their fields come from. A Human
gate is Archon's paused Run, so its project's Archon queue holds it and `factory asks`
reads it from there instead of from a label.

    factory ask <bead id> <kind> <question>              put an Ask on a Bead
    factory answer <ask> <words>                         record the Human's answer
    factory asks [--json] [--open] [--project <repo>]    list the Mac's Asks

`factory asks` reads the projects in ~/.config/factory/projects and lists each Ask with its
project, kind, Bead, status, question, how to answer and when it was asked: the open Asks,
and the answered ones beside them until their Project Manager acts on the answer and
removes the label, so an answer whose Notice was lost still shows. --open leaves the
answered ones out. A gate is listed while its project's Archon queue lists the Run paused
at it, with the Run's id and the Bead the Run's message names. Its JSON form is what
screens such as archon-bar read, so they never reimplement the list. A listed folder that
is gone, or a project with no Asks, contributes nothing and does not fail the command; a
project whose Beads or Archon cannot be read is reported and skipped, so one broken
project never hides the rest.

`factory ask` writes the comment first and the label second. When bd refuses the Bead (a
mistyped id, a folder with no Beads) the command ends with a factory: line naming the Bead
and writes nothing else, so a Bead that is labelled always carries an Ask to read. `factory
ask <bead id> gate <question>` records a gate's question on its Bead, with no how to answer
and no label: the gate waits in Archon's queue already and is answered there with its Run's
id, and a label would make `factory asks` read a second, stale copy of it. The Project
Manager uses it to relay a gate once connectors exist.

`factory answer` is the only writer of answers. It runs in the project's folder, as a screen
or the Project Manager does. On a Bead Ask it refuses a Bead that no longer carries
`waiting-on-human`, so a late relay or a second tap changes nothing; on an open Ask it
writes the dated answer first and swaps the label second, then leaves a Notice for the
project's Project Manager through bin/tell-pm, the way a Run's ending does. On a Human gate
it runs `archon workflow approve` or `archon workflow reject --reason`, refuses a Run its
project's Archon queue no longer lists, then records the answer on the Run's Bead and
leaves the same Notice. A gate has no answered label: it is done when Archon no longer
lists it. A project whose .archon/.env names no FACTORY_PM_AGENT still records the answer,
because the answer in state is what the Project Manager's status check finds, and reports
the Notice it could not leave.

Everything here is mechanical: a comment, a label and a list, with no model call.
"""
import json
import os
import subprocess
import sys
from datetime import datetime

# A gate is the one kind Archon holds, and is answered with one of two words: approve
# alone, or reject and the Human's words after it, which the rework reads as its reason.
GATE = "gate"
APPROVE = "approve"
REJECT = "reject"
KINDS = ("decision", "grilling", "spec-review", GATE)
LABEL = "waiting-on-human"
ANSWERED = "answered"
BIN = os.path.dirname(os.path.realpath(__file__))
USAGE = (
    "usage: factory ask <bead id> <kind> <question> | factory answer <ask> <words> "
    "| factory asks [--json] [--open] [--project <repo>]"
)
# The prefix each field of an Ask's comment starts with, apart from the first line, which
# names the kind. One map writes the comment and reads it back, so the two cannot drift.
PREFIXES = {"asked": "Asked: ", "how_to_answer": "How to answer: ", "question": "Question: "}


def run_bd(*args):
    """Runs the Beads CLI in the current folder and hands back what it answered."""
    return subprocess.run(["bd", *args], capture_output=True, text=True)


def bd_write(bead, *args):
    """Runs a bd write on the Bead, passing bd's message on.

    bd refuses a mistyped Bead id or a folder with no Beads; that is an ordinary refusal,
    not a crash, so the command ends with a factory: line naming the Bead.
    """
    result = run_bd(*args)
    if result.returncode != 0:
        sys.stderr.write(result.stderr)
        sys.exit(f"factory: could not write to {bead}: bd {' '.join(args[:2])} failed")


def bd_json(*args):
    """Runs the Beads CLI and reads its JSON, or None when it could not answer.

    bd may refuse, or print something other than its JSON on stdout (a warning, say). Both
    are a bd that could not answer, so the caller reports and skips that project.
    """
    result = run_bd(*args)
    if result.returncode != 0:
        sys.stderr.write(result.stderr)
        return None
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        return None


def archon_json(repo, *args):
    """Runs the Archon CLI in the project's folder and reads its JSON, or None.

    Archon answers `workflow attention <run-id>` with ok false when the id names no Run,
    so the caller reads `ok` rather than the exit status; a command that answered plain
    text (an install with no project, say) is not JSON and is None.
    """
    try:
        result = subprocess.run(["archon", *args], cwd=repo, capture_output=True, text=True)
    except OSError as error:
        sys.stderr.write(f"factory: could not run archon: {error}\n")
        return None
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        if result.stderr:
            sys.stderr.write(result.stderr)
        return None


def run_bead(repo, run):
    """The Bead a Run's message names, or None when its project's Archon cannot say.

    A Project Manager starts a Run with "<pane> · <bead id>", and bin/bead owns that
    reading for every Run, so this asks it rather than reading the message its own way.
    """
    run_row = archon_json(repo, "workflow", "get", run, "--json")
    message = run_row.get("user_message", "") if isinstance(run_row, dict) else ""
    if not message:
        return None
    result = subprocess.run([os.path.join(BIN, "bead"), "--id", message], capture_output=True, text=True)
    bead = result.stdout.strip()
    return bead if result.returncode == 0 and bead else None


def local_date(stamp):
    """An Archon timestamp, such as 2026-11-18T18:51:09.649Z, as a local date and time.

    Archon reports pausedAt in UTC; the list shows when the Human was asked in the same
    local terms as the Asks held on Beads.
    """
    try:
        return datetime.fromisoformat(stamp.replace("Z", "+00:00")).astimezone().strftime("%Y-%m-%d %H:%M")
    except (AttributeError, ValueError):
        return stamp or ""


def env_file_value(path, key):
    """One value from a KEY=value file such as a project's .archon/.env, or None.

    A missing file, a missing key and a key the file leaves empty all answer None. The
    value may be quoted, because install quotes a value carrying a space or a quote.
    """
    try:
        with open(path) as handle:
            lines = handle.read().splitlines()
    except OSError:
        return None
    for line in lines:
        line = line.strip()
        if line.startswith(key + "="):
            value = line[len(key) + 1 :]
            if len(value) > 1 and value[0] == value[-1] and value[0] in "'\"":
                value = value[1:-1]
            return value or None
    return None


def ask_comment(bead, kind, question, asked):
    """An Ask's comment: its kind, when it was asked, how to answer and its question.

    A gate's comment leaves out how to answer: a gate is answered with its Run's id, which
    only Archon's queue names, so its comment is a record rather than a listable Ask.
    """
    lines = [f"Ask: {kind}", PREFIXES["asked"] + asked]
    if kind != GATE:
        lines.append(PREFIXES["how_to_answer"] + f'factory answer {bead} "<your answer>"')
    lines.append(PREFIXES["question"] + question)
    return "\n".join(lines)


def ask(argv):
    if len(argv) < 3:
        sys.exit(f"factory: ask needs a Bead id, a kind and a question\n{USAGE}")
    bead, kind, *words = argv
    if kind not in KINDS:
        sys.exit(f"factory: unknown kind '{kind}'; the kinds are {', '.join(KINDS)}")
    # The rest is one question: a shell that does not quote it still asks the whole thing.
    question = " ".join(words)
    asked = datetime.now().strftime("%Y-%m-%d %H:%M")
    # The comment first, so the label never advertises an Ask with no fields to read.
    bd_write(bead, "comments", "add", bead, ask_comment(bead, kind, question, asked))
    if kind == GATE:
        # A gate waits in Archon's queue, so its record carries no label: a label would make
        # `factory asks` read a second, stale copy of the same gate.
        print(f"factory: {bead} records a Human gate's question; Archon's queue holds the gate.")
        return
    bd_write(bead, "label", "add", bead, LABEL)
    print(f"factory: {bead} is now an Ask waiting on the Human: {kind}.")


def parse_ask(text):
    """An Ask's fields from its comment, or None when the comment is not an Ask's."""
    lines = text.split("\n")
    if not lines[0].startswith("Ask: "):
        return None
    fields = {}
    for line in lines[1:]:
        for field, prefix in PREFIXES.items():
            if line.startswith(prefix):
                fields[field] = line[len(prefix) :]
                break
        else:
            # A question runs over its lines; every other field is one line.
            if "question" in fields:
                fields["question"] += "\n" + line
    if not all(field in fields for field in PREFIXES):
        return None
    fields["kind"] = lines[0][len("Ask: ") :].strip()
    return fields


def project_name(repo):
    """The project a folder is, as its Asks name it: the folder's own name.

    A project is named the same way whether the path comes from the projects file, with a
    link or a trailing slash, or from the folder the command runs in.
    """
    return os.path.basename(os.path.realpath(repo))


def same_repo(one, other):
    """True when two paths name the same folder, with ~, a relative path and a link resolved.

    A session's working directory comes back as /private/var/... on a Mac where the projects
    file names /var/..., and --project . names whatever folder the caller stands in, so the
    two spellings must be resolved before they are compared.
    """
    return os.path.realpath(os.path.expanduser(one)) == os.path.realpath(os.path.expanduser(other))


def project_asks(repo):
    """One project's Asks, open ones first and then answered ones, read from its Beads.

    A Beads it cannot read is reported on stderr and skipped, so one broken project never
    hides the rest. A Bead carrying both labels is listed once, as open: the open label is
    the one that still waits on the Human.
    """
    if not os.path.isdir(repo):
        return []
    project = project_name(repo)
    found = []
    seen = set()
    skipped = False
    for status, label in (("open", LABEL), ("answered", ANSWERED)):
        listed = bd_json("-C", repo, "list", "--label", label, "--json", "--limit", "0")
        if not isinstance(listed, list):
            # Both label queries read the same database, so they fail together: report once.
            if not skipped:
                print(f"factory: skipped {project}: bd could not read its Beads", file=sys.stderr)
                skipped = True
            continue
        for bead in listed:
            if bead["id"] in seen:
                continue
            seen.add(bead["id"])
            comments = bd_json("-C", repo, "comments", bead["id"], "--json")
            if not isinstance(comments, list):
                print(f"factory: skipped {project} {bead['id']}: bd could not read its comments", file=sys.stderr)
                continue
            # The latest Ask's comment holds the Ask; a later answer's comment is not one.
            for comment in reversed(comments):
                fields = parse_ask(comment.get("text", ""))
                if fields:
                    found.append(
                        {
                            "project": project,
                            "kind": fields["kind"],
                            "bead": bead["id"],
                            "status": status,
                            "question": fields["question"],
                            "how_to_answer": fields["how_to_answer"],
                            "asked": fields["asked"],
                        }
                    )
                    break
    return found


def is_human_gate(item):
    """True when one Archon attention item is a Human gate: a wait on an approval.

    A usage limit, a select wait and a wait for a plain answer pause a Run too, but only an
    approval wait asks the Human to judge taste and fit, so only it is a gate.
    """
    return item.get("kind") == "attention" and item.get("form") == "approval"


def project_gates(repo):
    """One project's Human gates: the Runs its Archon queue lists paused at an approval wait.

    A gate lives in Archon, not on a Bead, so it is listed while the Run is in the queue and
    gone once the Run is answered; the Bead's dated comment is only the record. The Run's id
    is how `factory answer` names the gate, and its Bead is the one the Run's message names.
    A queue or a Run Archon cannot answer for is reported and skipped, so one broken project
    never hides the rest.
    """
    if not os.path.isdir(repo):
        return []
    project = project_name(repo)
    queue = archon_json(repo, "workflow", "attention", "--json")
    if not isinstance(queue, dict) or not isinstance(queue.get("items"), list):
        print(f"factory: skipped {project} gates: archon could not read its attention queue", file=sys.stderr)
        return []
    found = []
    for item in queue["items"]:
        if not is_human_gate(item):
            continue
        run = item.get("runId")
        bead = run_bead(repo, run) if run else None
        if not bead:
            print(f"factory: skipped {project} gate {run}: its Bead could not be read", file=sys.stderr)
            continue
        found.append(
            {
                "project": project,
                "kind": GATE,
                "bead": bead,
                "run": run,
                "status": "open",
                "question": item.get("message", ""),
                "how_to_answer": f'factory answer {run} {APPROVE}, or factory answer {run} {REJECT} "<your words>"',
                "asked": local_date(item.get("pausedAt")),
            }
        )
    return found


def asks(argv):
    as_json = False
    open_only = False
    wanted = None
    while argv:
        if argv[0] == "--json":
            as_json = True
            argv = argv[1:]
        elif argv[0] == "--open":
            open_only = True
            argv = argv[1:]
        elif argv[0] == "--project":
            if len(argv) < 2:
                sys.exit(f"factory: --project needs the repo to limit the list to\n{USAGE}")
            wanted = argv[1]
            argv = argv[2:]
        else:
            sys.exit(f"factory: asks does not take '{argv[0]}'\n{USAGE}")
    projects_file = os.path.join(os.path.expanduser("~"), ".config", "factory", "projects")
    repos = []
    if os.path.isfile(projects_file):
        with open(projects_file) as handle:
            repos = [line.strip() for line in handle if line.strip()]
    found = []
    for repo in repos:
        if wanted is None or same_repo(wanted, repo):
            # A paused Run comes first: a gate holds work that is ready to land, where a
            # Bead's Ask waits on a question the Project Manager can carry on around.
            found.extend(project_gates(repo))
            found.extend(project_asks(repo))
    if open_only:
        found = [ask for ask in found if ask["status"] == "open"]
    if as_json:
        print(json.dumps(found, indent=2))
        return
    for index, ask in enumerate(found):
        if index:
            print()
        print(f"{ask['project']}  {ask['bead']}  {ask['kind']}  {ask['status']}  asked {ask['asked']}")
        for line in ask["question"].split("\n"):
            print(f"  {line}")
        print(f"  How to answer: {ask['how_to_answer']}")


def answer_comment(text):
    """The Human's answer as the Bead records it, dated, for every kind of Ask."""
    return f"The Human's answer, {datetime.now().strftime('%Y-%m-%d %H:%M')}: {text}"


def record_answer(bead, words):
    """Writes the Human's answer into state: the dated comment, then the label swap.

    The answer goes on the Bead before the label moves, so an Ask labelled answered always
    carries the words its status promises.
    """
    bd_write(bead, "comments", "add", bead, answer_comment(words))
    bd_write(bead, "label", "remove", bead, LABEL)
    bd_write(bead, "label", "add", bead, ANSWERED)


def tell_project_manager(bead, words):
    """Leaves the Notice a Run's ending leaves, for the Project Manager of this project.

    The command runs in the project's folder, as a screen or the Project Manager does, so
    that folder's .archon/.env names the pane. A project that names no pane names no
    Project Manager, so the answer is recorded and the command ends saying so.
    """
    repo = os.getcwd()
    project = project_name(repo)
    pane = env_file_value(os.path.join(repo, ".archon", ".env"), "FACTORY_PM_AGENT")
    if not pane:
        sys.exit(
            f"factory: recorded the Human's answer on {bead}, but {repo}/.archon/.env names no "
            f"FACTORY_PM_AGENT, so {project}'s Project Manager was not told"
        )
    tell_pm = os.path.join(BIN, "tell-pm")
    notice = f"The Human answered Ask {bead} in {project}: {words}"
    told = subprocess.run([tell_pm, pane, notice], capture_output=True, text=True)
    if told.returncode != 0:
        sys.stderr.write(told.stderr)
        sys.exit(f"factory: recorded the Human's answer on {bead}, but bin/tell-pm could not tell {pane}")
    print(f"factory: recorded the Human's answer on {bead} and told {pane}.")


def answer_gate(run, words):
    """Answers a Human gate in Archon, records it on the Run's Bead, tells the Project Manager.

    Archon's queue is the gate's state, so the answer reaches it first: `approve`, or `reject`
    with the Human's words as the reason its rework reads. The Run resumes in the background
    (--detach), so this returns as soon as Archon accepts the answer and the Bead comment and
    the Notice are not held up by the landing that follows. The Bead is read from the Run's
    message before the answer, so the record names it either way. A gate has no answered
    label: it is done when Archon no longer lists it.
    """
    decision, *rest = words
    reason = " ".join(rest).strip()
    if decision == APPROVE:
        if reason:
            sys.exit(f"factory: approve takes no words after it; reject with the Human's words\n{USAGE}")
        command, answer = ["workflow", APPROVE, run, "--detach"], f"approved gate Run {run}"
    else:
        if not reason:
            sys.exit(f"factory: reject needs the Human's words for the rework\n{USAGE}")
        command = ["workflow", REJECT, run, "--reason", reason, "--detach"]
        answer = f"rejected gate Run {run}: {reason}"
    repo = os.getcwd()
    bead = run_bead(repo, run)
    if not bead:
        sys.exit(f"factory: could not read the Bead Run {run} names, so nothing was recorded")
    result = subprocess.run(["archon", *command], cwd=repo, capture_output=True, text=True)
    if result.returncode != 0:
        sys.stderr.write(result.stderr)
        sys.exit(f"factory: archon could not {decision} Run {run}, so nothing was recorded")
    bd_write(bead, "comments", "add", bead, answer_comment(answer))
    tell_project_manager(bead, answer)


def answer(argv):
    """Records the Human's answer on an open Ask, then tells its Project Manager.

    The answer goes into state first: an answer whose Notice goes missing is still on the
    Bead, where the Project Manager's status check finds it. An Ask that is no longer open
    is refused and nothing is written, so a late relay or a second tap changes nothing.
    A gate's answer goes to Archon, whose queue is its state; a Bead id names no Run, so an
    answer to a Bead that begins with "approve" or "reject" still goes to the Bead.
    """
    if len(argv) < 2:
        sys.exit(f"factory: answer needs an Ask and the Human's answer\n{USAGE}")
    ask_id, *words = argv
    joined = " ".join(words).strip()
    if not joined:
        sys.exit(f"factory: answer needs the Human's words for {ask_id}\n{USAGE}")
    if words[0] in (APPROVE, REJECT):
        waiting = archon_json(os.getcwd(), "workflow", "attention", ask_id, "--json")
        item = waiting.get("item") if isinstance(waiting, dict) and waiting.get("ok") else None
        if isinstance(item, dict):
            if not is_human_gate(item):
                sys.exit(f"factory: Run {ask_id} waits on something other than a Human gate, so nothing was answered")
            answer_gate(ask_id, words)
            return
        if isinstance(waiting, dict) and waiting.get("ok"):
            project = project_name(os.getcwd())
            sys.exit(f"factory: gate {ask_id} no longer waits in {project}'s Archon queue, so nothing was answered")
        # Archon knows no Run by this id, or could not be read: it is a Bead, and an answer to
        # an Ask there may begin with a decision word, so all of it is the Human's answer.
    labels = bd_json("label", "list", ask_id, "--json")
    if not isinstance(labels, list):
        sys.exit(f"factory: could not read the labels on {ask_id}, so nothing was recorded")
    if LABEL not in labels:
        sys.exit(f"factory: {ask_id} carries no open Ask, so nothing was recorded")
    record_answer(ask_id, joined)
    tell_project_manager(ask_id, joined)


def main(argv):
    if not argv:
        sys.exit(USAGE)
    verb, rest = argv[0], argv[1:]
    if verb == "ask":
        ask(rest)
    elif verb == "answer":
        answer(rest)
    elif verb == "asks":
        asks(rest)
    else:
        sys.exit(f"factory: no verb '{verb}'\n{USAGE}")


if __name__ == "__main__":
    main(sys.argv[1:])
