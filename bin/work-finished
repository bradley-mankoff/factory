#!/bin/sh
# work-finished <bead id>: the node a build Workflow runs after its work node.
#
# The pi-flows package writes the checks an agent finished with still failing to the Run's
# artifacts folder as flows-failed.txt, one line per failure (fac-qpv.3.1). When that file
# is missing or empty, the work node's checks passed, so this node passes and the reviews
# run. Otherwise it comments the failed checks on the Bead, naming the Run, and exits 1:
# the reviews depend on this node, so they do not run, and no usage is spent reviewing
# unfinished work (fac-qpv.3.3). The Workflow's last node still tells the Project Manager
# how the Run ended, because bin/finish reads the notes in the Run's artifacts rather than
# this node's output. Run it from the Run's worktree, where `bd` finds the project's Beads.
set -eu
bead=${1:?work-finished: give the Bead id}
failures="${ARTIFACTS_DIR:-}/flows-failed.txt"
if [ ! -s "$failures" ]; then
	printf 'work-finished: the work node left no failed checks.\n'
	exit 0
fi
comment=$(printf 'Work finished with failed checks in Run %s; the reviews did not run, and the commits stay on its branch:\n%s' "${WORKFLOW_ID:-an unnamed run}" "$(cat "$failures")")
printf '%s\n' "$comment"
if ! bd comments add "$bead" "$comment"; then
	printf 'work-finished: could not comment the failed checks on %s.\n' "$bead" >&2
fi
exit 1
