#!/usr/bin/env python3
"""Says how much of the Human's Claude plan is left, in one line, before a Run starts.

    claude-usage

The Factory reads this for its warnings (fac-qpv.1.4): FactoryClaw runs it before a
message that leads to a Run, and it is the only caller. No Workflow node runs it, because a
Run's nodes move down their Chains when an account runs out. The plan's two windows, 5
hours and a week, are checked only when a Run is about to start, never during one. The line
begins with one of:

    Claude usage OK          more than 25% of 5 hours and more than 6% of the week left
    Claude usage is low      25% or less of 5 hours, or 6% or less of the week
    Claude usage is very low 10% or less of 5 hours, or 2% or less of the week
    Claude usage is used up  0% of either; exits 1 as the strongest warning

(the Human's thresholds, 2026-10-25). Nothing stops at 0%: a Project Manager and a Run's
nodes run on Chains and move to the next model when an account is used up (fac-qpv.1), so
the exit code only says how loud the warning is. There is no monthly limit, and Claude's
quota error cannot tell the two windows apart, which is why the check reads the usage
itself.
A usage that cannot be read is said so, with the HTTP status when there is one and never
the login, and exits 0: a network fault does not stop work, and FactoryClaw stays silent.

It reads the usage the way Claude Code's /usage does: the Human's Claude Code login from
the macOS keychain, sent only to Anthropic's usage endpoint and never printed.
"""
import datetime
import json
import subprocess
import sys
import urllib.error
import urllib.request

LEVELS = [  # (name, % of 5 hours, % of the week): the first level either window reaches
    ("is used up", 0, 0),
    ("is very low", 10, 2),
    ("is low", 25, 6),
]
NAMES = {"five_hour": "the 5-hour window", "seven_day": "the week"}


def usage():
    secret = subprocess.run(
        ["security", "find-generic-password", "-s", "Claude Code-credentials", "-w"],
        capture_output=True, text=True, timeout=10, check=True,
    ).stdout
    token = json.loads(secret)["claudeAiOauth"]["accessToken"]
    request = urllib.request.Request(
        "https://api.anthropic.com/api/oauth/usage",
        headers={"Authorization": f"Bearer {token}", "anthropic-beta": "oauth-2025-04-20"},
    )
    with urllib.request.urlopen(request, timeout=30) as response:
        return json.load(response)


def resets(window):
    at = datetime.datetime.fromisoformat(window["resets_at"]).astimezone()
    return at.strftime("%a %-I:%M %p").replace(":00", "")


try:
    plan = usage()
    left = {w: max(0.0, 100 - plan[w]["utilization"]) for w in NAMES}
except Exception as error:  # no login, no network, a changed reply
    # Only the status code or the error's type: an error's text could carry the request.
    reason = f"HTTP {error.code}" if isinstance(error, urllib.error.HTTPError) else type(error).__name__
    print(f"Claude usage could not be read ({reason}), so the Run may start.")
    sys.exit(0)

for name, five_hour, week in LEVELS:
    hit = [w for w, limit in (("five_hour", five_hour), ("seven_day", week)) if left[w] <= limit]
    if hit:
        parts = [f"{left[w]:.0f}% of {NAMES[w]} left until {resets(plan[w])}" for w in hit]
        rest = [f"{left[w]:.0f}% of {NAMES[w]}" for w in NAMES if w not in hit]
        line = f"Claude usage {name}: {' and '.join(parts)}" + (f"; {rest[0]} left." if rest else ".")
        if name == "is used up":
            print(line + " No Run can start until then.")
            sys.exit(1)
        print(line)
        sys.exit(0)
print(f"Claude usage OK: {left['five_hour']:.0f}% of the 5-hour window and {left['seven_day']:.0f}% of the week left.")
